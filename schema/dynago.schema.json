        },
        "set": {
          "$ref": "#/$defs/predicates",
          "description": "Changes the required entity in the same transaction, maintaining its counters, indexes, claims and copies. Values are constants or \"{field}\" of this entity."
        },
        "optional": {
          "type": "boolean",
          "default": false,
          "description": "The write goes ahead if the entity is absent or expired; when applies only to one that is there."
