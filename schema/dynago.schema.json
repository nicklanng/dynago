{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/nicklanng/dynago/main/schema/dynago.schema.json",
  "title": "dynago schema",
  "description": "A DynamoDB table: its entities, how they are keyed, and every way they are read and written. See docs/schema.md.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "dynago",
    "package",
    "table",
    "entities"
  ],
  "properties": {
    "dynago": {
      "const": 1,
      "description": "Schema format version. Always 1."
    },
    "package": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*$",
      "description": "Go package name of the generated code."
    },
    "table": {
      "$ref": "#/$defs/table"
    },
    "output": {
      "$ref": "#/$defs/output"
    },
    "workload": {
      "$ref": "#/$defs/workload"
    },
    "entities": {
      "type": "object",
      "description": "The entities stored in the table, by PascalCase name.",
      "minProperties": 1,
      "propertyNames": {
        "$ref": "#/$defs/pascalName"
      },
      "additionalProperties": {
        "$ref": "#/$defs/entity"
      }
    }
  },
  "$defs": {
    "pascalName": {
      "type": "string",
      "pattern": "^[A-Z][A-Za-z0-9]*$"
    },
    "camelName": {
      "type": "string",
      "pattern": "^[a-z][A-Za-z0-9]*$"
    },
    "doc": {
      "type": "string",
      "description": "Documentation copied into the generated Go and model document."
    },
    "keyTemplate": {
      "type": "string",
      "minLength": 1,
      "description": "Literal text with {field} placeholders, e.g. \"LIB#{libraryId}#TOOL#{toolId}\". Placeholders must be separated by literal text. {field|lower} puts the lower-cased value in the key."
    },
    "sortKeyTemplate": {
      "type": "string",
      "pattern": "^[^{]",
      "description": "A key template that starts with literal text, so its items can be told apart from other items in the same partition."
    },
    "scalar": {
      "type": [
        "string",
        "number",
        "boolean"
      ]
    },
    "predicates": {
      "type": "object",
      "description": "Constants by field: {field: value}.",
      "minProperties": 1,
      "propertyNames": {
        "$ref": "#/$defs/camelName"
      },
      "additionalProperties": {
        "$ref": "#/$defs/scalar"
      }
    },
    "conditions": {
      "type": "object",
      "description": "Conditions on fields, all of which must hold: {field: value} (equal to it), {field: {not: value}} (any other value) or {field: {in: [value, ...]}} (one of them).",
      "minProperties": 1,
      "propertyNames": {
        "$ref": "#/$defs/camelName"
      },
      "additionalProperties": {
        "oneOf": [
          {
            "$ref": "#/$defs/scalar"
          },
          {
            "type": "object",
            "properties": {
              "not": {
                "$ref": "#/$defs/scalar",
                "description": "The field holds any value but this one."
              }
            },
            "required": [
              "not"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "in": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/scalar"
                },
                "minItems": 2,
                "uniqueItems": true,
                "description": "The field holds one of these values."
              }
            },
            "required": [
              "in"
            ],
            "additionalProperties": false
          }
        ]
      }
    },
    "fieldList": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/camelName"
      },
      "uniqueItems": true
    },
    "accept": {
      "type": "object",
      "description": "Findings of dynago check this schema records as deliberate: rule id → the reason. Errors can't be accepted. See docs/guides/analysis.md.",
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z][a-z-]*$"
      },
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "workload": {
      "type": "object",
      "additionalProperties": false,
      "description": "Table-wide workload assumptions for the analysis.",
      "properties": {
        "peak": {
          "type": "number",
          "minimum": 1,
          "default": 1,
          "description": "Peak traffic as a multiple of the declared average rates."
        },
        "horizon": {
          "type": "string",
          "description": "When the declared volumes are expected, e.g. \"3 years\". Shown to readers."
        }
      }
    },
    "table": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "description": "Base table name: each generation's table is <name>-g<generation>. Also the default of the Terraform variable for the base name, and the base of output file names."
        },
        "doc": {
          "$ref": "#/$defs/doc"
        },
        "ttl_attribute": {
          "type": "string",
          "default": "ttl",
          "description": "Attribute holding the expiry time in epoch seconds."
        },
        "generation": {
          "type": "integer",
          "minimum": 1,
          "default": 1,
          "description": "The table generation. A change existing items don't fit (a new index, claim or counter, a changed key or field type) needs a new generation: a new table, named <name>-g<generation>, filled by the generated migration job."
        },
        "retain": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1
          },
          "uniqueItems": true,
          "description": "Older generations whose tables stay declared in Terraform, for rollback. To delete one, turn off its deletion protection outside the Terraform (the generated Terraform always enables it), then remove it here."
        },
        "accept": {
          "$ref": "#/$defs/accept"
        }
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "description": "Paths of generated files, relative to the schema file.",
      "properties": {
        "go": {
          "type": "string",
          "description": "Default <table>_dynago.go"
        },
        "docs": {
          "type": "string",
          "description": "Default <table>.model.md"
        },
        "terraform": {
          "type": "string",
          "description": "Default <table>.tf.json"
        },
        "table_json": {
          "type": "string",
          "description": "Default <table>.table.json"
        },
        "lock": {
          "type": "string",
          "description": "Default <table>.dynago.lock"
        },
        "migrate_cmd": {
          "type": "string",
          "description": "Directory (relative to the schema file) of the generated migration job's main package, for example cmd/migrate-orders. Omit it to call RunMigration from your own command."
        }
      }
    },
    "entity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fields",
        "key"
      ],
      "properties": {
        "doc": {
          "$ref": "#/$defs/doc"
        },
        "version": {
          "type": "integer",
          "minimum": 1,
          "default": 1,
          "description": "Storage shape version. Bump it whenever fields, keys, indexes, claims or counters change."
        },
        "fields": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "$ref": "#/$defs/camelName"
          },
          "additionalProperties": {
            "$ref": "#/$defs/field"
          }
        },
        "key": {
          "$ref": "#/$defs/key"
        },
        "ttl": {
          "$ref": "#/$defs/camelName",
          "description": "A time field: the item expires at that time."
        },
        "indexes": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/pascalName"
          },
          "additionalProperties": {
            "$ref": "#/$defs/index"
          }
        },
        "unique": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/pascalName"
          },
          "additionalProperties": {
            "$ref": "#/$defs/unique"
          }
        },
        "counters": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/pascalName"
          },
          "additionalProperties": {
            "$ref": "#/$defs/counter"
          }
        },
        "access": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/pascalName"
          },
          "additionalProperties": {
            "$ref": "#/$defs/access"
          }
        },
        "writes": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/pascalName"
          },
          "additionalProperties": {
            "$ref": "#/$defs/write"
          }
        },
        "volume": {
          "$ref": "#/$defs/volume"
        },
        "accept": {
          "$ref": "#/$defs/accept"
        }
      }
    },
    "key": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pk",
        "sk"
      ],
      "properties": {
        "pk": {
          "$ref": "#/$defs/keyTemplate"
        },
        "sk": {
          "$ref": "#/$defs/sortKeyTemplate"
        }
      }
    },
    "volume": {
      "oneOf": [
        {
          "type": "number",
          "minimum": 0,
          "description": "The number of items in the table."
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "typical"
          ],
          "properties": {
            "per": {
              "$ref": "#/$defs/pascalName",
              "description": "The entity the numbers are per. Default: the entity whose partition this one's nests in."
            },
            "via": {
              "type": "string",
              "description": "The field linking to the per entity, when this entity holds its key more than one way."
            },
            "typical": {
              "type": "number",
              "minimum": 0,
              "description": "Items per parent, typically."
            },
            "max": {
              "type": "number",
              "minimum": 0,
              "description": "Items per parent, at most: the biggest parent's count."
            },
            "by": {
              "type": "object",
              "description": "How the items spread over other entities whose keys they hold.",
              "propertyNames": {
                "$ref": "#/$defs/pascalName"
              },
              "additionalProperties": {
                "$ref": "#/$defs/volumeBy"
              }
            }
          }
        }
      ],
      "description": "How many items to expect: a number (the total), or typical and max per parent."
    },
    "volumeBy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "typical"
      ],
      "properties": {
        "typical": {
          "type": "number",
          "minimum": 0
        },
        "max": {
          "type": "number",
          "minimum": 0
        },
        "via": {
          "type": "string",
          "description": "The field linking to this entity, when the item holds its key more than one way."
        }
      }
    },
    "fieldType": {
      "enum": [
        "string",
        "enum",
        "int",
        "float",
        "bool",
        "time",
        "bytes",
        "string_list",
        "string_set",
        "string_map"
      ]
    },
    "field": {
      "oneOf": [
        {
          "$ref": "#/$defs/fieldType"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type"
          ],
          "properties": {
            "type": {
              "$ref": "#/$defs/fieldType"
            },
            "attr": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_.-]+$",
              "description": "Stored attribute name; defaults to the field name."
            },
            "doc": {
              "$ref": "#/$defs/doc"
            },
            "size": {
              "type": [
                "string",
                "integer"
              ],
              "pattern": "^[0-9]+(/[0-9]+)?$",
              "description": "Bytes, or p50/p99 bytes, for the cost estimate."
            },
            "example": {
              "type": [
                "string",
                "number",
                "boolean"
              ],
              "description": "Example value shown in rendered keys in the model document."
            },
            "values": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 1,
              "uniqueItems": true,
              "description": "The values of an enum field."
            },
            "copy_of": {
              "type": "string",
              "pattern": "^[A-Z][A-Za-z0-9]*\\.[a-z][A-Za-z0-9]*$",
              "description": "Entity.field this field copies and must stay equal to. dynago does not keep it in sync: dynago check warns, saying how many items a change of the source fans out to."
            },
            "snapshot_of": {
              "type": "string",
              "pattern": "^[A-Z][A-Za-z0-9]*\\.[a-z][A-Za-z0-9]*$",
              "description": "Entity.field whose value this field takes when the item is written, deliberately never updated (a name at the time of an order). Exclusive with copy_of."
            },
            "ref": {
              "$ref": "#/$defs/pascalName",
              "description": "The entity whose key this field holds, when the field's name doesn't match the key field's."
            },
            "required": {
              "type": "boolean",
              "default": false,
              "description": "Writes may not leave this field at its zero value (dynago.ErrFieldRequired): creates must set it, and updates may not clear it."
            },
            "accept": {
              "$ref": "#/$defs/accept"
            }
          },
          "if": {
            "properties": {
              "type": {
                "const": "enum"
              }
            }
          },
          "then": {
            "required": [
              "values"
            ]
          },
          "else": {
            "not": {
              "required": [
                "values"
              ]
            }
          }
        }
      ]
    },
    "projection": {
      "oneOf": [
        {
          "enum": [
            "all",
            "keys"
          ]
        },
        {
          "$ref": "#/$defs/fieldList"
        }
      ]
    },
    "index": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pk",
        "project"
      ],
      "properties": {
        "strategy": {
          "enum": [
            "gsi",
            "copy"
          ],
          "description": "gsi: a global secondary index maintained by DynamoDB, read eventually consistently. copy: copy items written in the same transaction, readable immediately. Default: copy if a read through it needs freshness: immediate, else gsi."
        },
        "pk": {
          "$ref": "#/$defs/keyTemplate"
        },
        "sk": {
          "$ref": "#/$defs/keyTemplate"
        },
        "project": {
          "$ref": "#/$defs/projection"
        },
        "where": {
          "$ref": "#/$defs/conditions"
        },
        "matches": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1,
          "description": "The share of the entity's items that satisfy where (0.01 is one in a hundred), for sizing the index, its traffic and the writes that maintain it. Without it, every item is counted, as an upper bound."
        },
        "doc": {
          "$ref": "#/$defs/doc"
        },
        "accept": {
          "$ref": "#/$defs/accept"
        }
      },
      "if": {
        "properties": {
          "strategy": {
            "const": "copy"
          }
        },
        "required": [
          "strategy"
        ]
      },
      "then": {
        "required": [
          "sk"
        ],
        "properties": {
          "sk": {
            "$ref": "#/$defs/sortKeyTemplate"
          }
        }
      }
    },
    "unique": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fields"
      ],
      "properties": {
        "fields": {
          "allOf": [
            {
              "$ref": "#/$defs/fieldList"
            },
            {
              "minItems": 1
            }
          ]
        },
        "pk": {
          "$ref": "#/$defs/keyTemplate",
          "description": "Default UNIQUE#<Entity>.<Name>#{field}..."
        },
        "sk": {
          "$ref": "#/$defs/keyTemplate",
          "description": "Default UNIQUE"
        },
        "doc": {
          "$ref": "#/$defs/doc"
        },
        "accept": {
          "$ref": "#/$defs/accept"
        }
      }
    },
    "counter": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pk",
        "sk",
        "values"
      ],
      "properties": {
        "pk": {
          "$ref": "#/$defs/keyTemplate"
        },
        "sk": {
          "$ref": "#/$defs/sortKeyTemplate"
        },
        "shards": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100,
          "default": 1,
          "description": "Spread writes over this many counter items; reads sum them."
        },
        "doc": {
          "$ref": "#/$defs/doc"
        },
        "values": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "$ref": "#/$defs/camelName"
          },
          "additionalProperties": {
            "$ref": "#/$defs/counterValue"
          }
        },
        "accept": {
          "$ref": "#/$defs/accept"
        }
      }
    },
    "counterValue": {
      "oneOf": [
        {
          "const": "count"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "count": {
              "const": true
            },
            "sum": {
              "$ref": "#/$defs/camelName",
              "description": "An int field to sum."
            },
            "where": {
              "$ref": "#/$defs/conditions"
            },
            "limit": {
              "oneOf": [
                {
                  "type": "integer",
                  "minimum": 1
                },
                {
                  "const": "arg"
                }
              ],
              "description": "Upper bound: a number, or arg for a caller-supplied dynago.Limit."
            },
            "min": {
              "type": "integer",
              "minimum": 0,
              "description": "Lower bound: writes that would take the value below it fail."
            },
            "doc": {
              "$ref": "#/$defs/doc"
            }
          },
          "oneOf": [
            {
              "required": [
                "count"
              ]
            },
            {
              "required": [
                "sum"
              ]
            }
          ]
        }
      ]
    },
    "access": {
      "oneOf": [
        {
          "const": "get"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "get": {
              "oneOf": [
                {
                  "const": "key"
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "unique"
                  ],
                  "properties": {
                    "unique": {
                      "$ref": "#/$defs/pascalName"
                    }
                  }
                }
              ]
            },
            "query": {
              "type": "string",
              "description": "key (the entity's own partition) or an index name."
            },
            "counter": {
              "$ref": "#/$defs/pascalName"
            },
            "scan": {
              "const": true,
              "description": "Read every item of the entity, one page of the whole table per call. A declared exception: give a reason."
            },
            "reason": {
              "type": "string",
              "minLength": 1,
              "description": "Why a scan is needed."
            },
            "order": {
              "enum": [
                "asc",
                "desc"
              ],
              "default": "asc"
            },
            "page": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000,
              "default": 50
            },
            "max_page": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000,
              "description": "Default max(100, page)."
            },
            "range": {
              "$ref": "#/$defs/camelName",
              "description": "Adds From/To bounds on the sort key's first placeholder."
            },
            "consistent": {
              "type": "boolean",
              "description": "Strongly consistent read (twice the cost). Default false, except for queries through a copy index, which default to true. Not allowed on a GSI. Prefer freshness, which states the need."
            },
            "freshness": {
              "enum": [
                "immediate",
                "eventual"
              ],
              "description": "What the reader needs. immediate: read-your-writes (a consistent read; an index read through becomes a copy). eventual: a moment's lag is fine."
            },
            "doc": {
              "$ref": "#/$defs/doc"
            },
            "rate": {
              "type": "number",
              "minimum": 0,
              "description": "Average calls per second, for the cost estimate and the partition analysis."
            },
            "project": {
              "$ref": "#/$defs/projection",
              "description": "For query: key only. Read just these fields (plus key fields), for bandwidth and to keep other fields from callers. DynamoDB still bills the whole item."
            },
            "accept": {
              "$ref": "#/$defs/accept"
            }
          },
          "oneOf": [
            {
              "required": [
                "get"
              ]
            },
            {
              "required": [
                "query"
              ]
            },
            {
              "required": [
                "counter"
              ]
            },
            {
              "required": [
                "scan",
                "reason"
              ]
            }
          ]
        }
      ]
    },
    "write": {
      "oneOf": [
        {
          "enum": [
            "create",
            "delete"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "create": {
              "const": true
            },
            "delete": {
              "const": true
            },
            "update": {
              "$ref": "#/$defs/fieldList",
              "description": "Fields the caller supplies."
            },
            "set": {
              "$ref": "#/$defs/predicates",
              "description": "Fields set to constants. On a create, they override what the caller passed (a new loan is always active)."
            },
            "when": {
              "$ref": "#/$defs/conditions",
              "description": "Preconditions that must hold for the update."
            },
            "versioned": {
              "enum": [
                "optional",
                "required"
              ],
              "default": "optional"
            },
            "doc": {
              "$ref": "#/$defs/doc"
            },
            "rate": {
              "type": "number",
              "minimum": 0,
              "description": "Average calls per second, for the cost estimate and the partition analysis."
            },
            "hot_key_rate": {
              "type": "number",
              "minimum": 0,
              "description": "Peak calls per second against one partition key, for hot-key warnings."
            },
            "patch": {
              "$ref": "#/$defs/fieldList",
              "description": "Optional fields the caller may supply: nil leaves the field unchanged."
            },
            "requires": {
              "type": "object",
              "description": "Conditions on other items of the table (entities, or counters by name), checked in the same transaction. A requirement on an entity may also change it (set) or delete it (consume).",
              "propertyNames": {
                "$ref": "#/$defs/pascalName"
              },
              "additionalProperties": {
                "$ref": "#/$defs/require"
              }
            },
            "accept": {
              "$ref": "#/$defs/accept"
            }
          },
          "oneOf": [
            {
              "required": [
                "create"
              ],
              "not": {
                "anyOf": [
                  {
                    "required": [
                      "delete"
                    ]
                  },
                  {
                    "required": [
                      "update"
                    ]
                  },
                  {
                    "required": [
                      "patch"
                    ]
                  },
                  {
                    "required": [
                      "when"
                    ]
                  },
                  {
                    "required": [
                      "versioned"
                    ]
                  }
                ]
              }
            },
            {
              "required": [
                "delete"
              ],
              "not": {
                "anyOf": [
                  {
                    "required": [
                      "create"
                    ]
                  },
                  {
                    "required": [
